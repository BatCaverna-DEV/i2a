# ===========================================================
# Configuração do servidor
# ===========================================================
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# Origens permitidas pelo CORS (separadas por vírgula)
CORS_ORIGIN=http://localhost:5173

# ===========================================================
# Banco de dados MariaDB
# ===========================================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=i2a
DB_USER=i2a_user
DB_PASSWORD=troque_esta_senha
DB_LOGGING=false

# Cria/atualiza as tabelas automaticamente na subida (deixe false: use npm run db)
DB_SYNC=false
DB_SYNC_ALTER=false

# ===========================================================
# Login com Google
# ===========================================================
# Client ID do OAuth 2.0 criado no Google Cloud Console
# (APIs e Serviços → Credenciais → ID do cliente OAuth → Aplicativo da Web).
#
# Em "Origens JavaScript autorizadas" cadastre a URL do FRONTEND:
#   http://localhost:5173   (desenvolvimento)
#   https://seu-dominio      (produção)
#
# Não é preciso "URI de redirecionamento": o fluxo usado devolve o token
# na própria página, sem redirecionar.
#
# Este mesmo valor vai em VITE_GOOGLE_CLIENT_ID no frontend.
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# O Client Secret NÃO é usado neste fluxo — não precisa ser guardado aqui.

# ===========================================================
# Tokens da própria aplicação (emitidos após o login pelo Google)
# ===========================================================
JWT_SECRET=gere_um_segredo_longo_e_aleatorio_aqui
JWT_EXPIRES_IN=2h

JWT_REFRESH_SECRET=gere_outro_segredo_diferente_aqui
JWT_REFRESH_EXPIRES_IN=7d

# ===========================================================
# Usuário administrador inicial (criado por npm run db)
# ===========================================================
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_NOME=Administrador I2A

# E-MAIL DA CONTA GOOGLE que poderá entrar na área administrativa.
# Precisa ser o endereço exato da conta — é ele que libera o acesso.
SEED_ADMIN_EMAIL=preencha@gmail.com

# ===========================================================
# Candidaturas às vagas
# ===========================================================
# Domínio obrigatório do e-mail acadêmico do candidato (subdomínios valem:
# acad.ifma.edu.br passa com ifma.edu.br). Deixe vazio para aceitar qualquer e-mail.
EMAIL_ACADEMICO_DOMINIO=ifma.edu.br
