# ===========================================================
# Configuração do servidor
# ===========================================================
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# Origens permitidas pelo CORS (separadas por vírgula)
CORS_ORIGIN=http://localhost:5173

# ===========================================================
# Banco de dados MariaDB
# ===========================================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=i2a
DB_USER=i2a_user
DB_PASSWORD=troque_esta_senha
DB_LOGGING=false

# Cria/atualiza as tabelas automaticamente na subida (apenas em dev)
DB_SYNC=false
DB_SYNC_ALTER=false

# ===========================================================
# Autenticação JWT
# ===========================================================
JWT_SECRET=gere_um_segredo_longo_e_aleatorio_aqui
JWT_EXPIRES_IN=2h
JWT_REFRESH_SECRET=gere_outro_segredo_diferente_aqui
JWT_REFRESH_EXPIRES_IN=7d

# Token temporário emitido entre a senha e o código do Google Authenticator
JWT_MFA_SECRET=gere_um_terceiro_segredo_aqui
JWT_MFA_EXPIRES_IN=5m

# ===========================================================
# Google Authenticator (TOTP - RFC 6238)
# ===========================================================
TOTP_ISSUER=Grupo I2A - IFMA
# Janela de tolerância (em passos de 30s) para diferença de relógio
TOTP_WINDOW=1

# ===========================================================
# Usuário administrador inicial (usado por npm run db:seed)
# ===========================================================
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=troque_esta_senha
SEED_ADMIN_NOME=Administrador I2A
SEED_ADMIN_EMAIL=admin@i2a.ifma.edu.br
