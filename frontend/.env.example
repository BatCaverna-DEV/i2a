# ===========================================================
# Dados de exemplo
# ===========================================================
# true  → site e painel funcionam sem o backend, lendo de src/mocks/
# false → tudo passa a consumir a API real em VITE_API_URL
#
# Nenhuma tela muda entre os dois modos: os services expõem a mesma
# assinatura nos dois casos (ver src/services/publicoService.js).
VITE_USE_MOCKS=true

# ===========================================================
# API
# ===========================================================
# URL base da API do backend usada pelo axios
VITE_API_URL=http://localhost:3000/api

# Alvo do proxy do Vite em desenvolvimento (evita CORS)
VITE_API_PROXY=http://localhost:3000

# ===========================================================
# Identidade do site público
# ===========================================================
VITE_APP_NOME=Grupo de Pesquisa I2A
VITE_APP_DESCRICAO=Inteligência Artificial e Aplicações — IFMA Campus Coelho Neto
VITE_APP_EMAIL=i2a@ifma.edu.br
